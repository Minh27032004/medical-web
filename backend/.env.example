# Copy các biến này vào môi trường chạy (IDE run config / Render Environment).
# Spring Boot đọc trực tiếp từ biến môi trường — KHÔNG commit file chứa giá trị thật.

# Supabase Postgres — BẮT BUỘC session mode port 5432 (docs/DECISIONS.md D10)
DATABASE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=<db-password>
DB_POOL_SIZE=8

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Chỉ đặt nếu project dùng HS256 (legacy) thay vì JWKS:
# SUPABASE_JWT_SECRET=
# Service role key — CHỈ backend được giữ, không bao giờ đưa lên frontend:
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Gemini
GEMINI_API_KEY=<gemini-api-key>

# CORS
FRONTEND_ORIGIN=http://localhost:3000
